# Copy this file to .env and fill in real values. NEVER commit the real .env file.

# Resend (https://resend.com) — used by every PHP form handler in /api
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="Herger's & Co. Website <no-reply@notifications.hergerandco.com>"

# All form submissions are delivered to this company inbox
COMPANY_EMAIL=info@hergerandco.com

# Calendly (used by the Schedule Free Consultation page to embed live booking availability)
CALENDLY_URL=https://calendly.com/hergerandco/free-consultation

# Comma separated list of allowed origins for CORS on the /api endpoints (leave blank for same-origin only)
ALLOWED_ORIGINS=https://www.hergerandco.com

# Simple shared secret used to validate the hidden honeypot/anti-bot field name (defense in depth only)
FORM_HONEYPOT_FIELD=hp_confirm
