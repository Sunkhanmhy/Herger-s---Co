{
  "name": "hergers-and-co",
  "version": "1.0.0",
  "private": true,
  "description": "Herger's & Co. corporate law firm website",
  "scripts": {
    "build:css": "tailwindcss -i ./src/css/input.css -o ./assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/css/input.css -o ./assets/css/tailwind.css --watch",
    "build:js": "esbuild src/ts/main.ts --bundle --minify --outfile=assets/js/main.js --target=es2019",
    "watch:js": "esbuild src/ts/main.ts --bundle --outfile=assets/js/main.js --target=es2019 --watch",
    "build:site": "python3 ../backend/scripts/generate_site.py",
    "build": "npm run build:css && npm run build:js && npm run build:site"
  },
  "devDependencies": {
    "esbuild": "^0.23.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  }
}
